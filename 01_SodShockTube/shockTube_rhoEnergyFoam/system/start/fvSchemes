    //div(phi,U)      Gauss MinmodV;

    //div(phi,U)      Gauss QUICK;
    //div(phi,U)      Gauss SuperBee;

/*
    div(phid,p)     Gauss limitedLinear 1;
    div(phiv,p)     Gauss limitedLinear 1;
    div(phi,K)      Gauss limitedLinear 1;
    div(phi,e)      Gauss limitedLinear 1;
*/

    energy1 LUST default;
    energy2 linearUpwind default;
    energy3 limitedLinear 1;
    energy4 Minmod;
    energy5 linear;
    energy6 upwind;

    div(phi,(p|rho)) Gauss linearUpwind default;

    //for sensibleInternalEnergy formulation - e
    div(phi,e)      Gauss $energy2;
    div(phi,K)      Gauss $energy2;
    div(phid,p)     Gauss $energy2;

    //for sensibleEnthalpy formulation - h
    //div(phi,h)      Gauss $energy2;
    //div(phi,K)      Gauss $energy2;
    //div(phid,p)     Gauss $energy2;

    div(((rho*nuEff)*dev2(T(grad(U))))) Gauss linear 1;
}

