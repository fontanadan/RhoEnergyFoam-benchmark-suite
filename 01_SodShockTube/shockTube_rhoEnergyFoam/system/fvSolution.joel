FoamFile
{
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "(p|U|e|h).*"
    {
/*
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-8;
        relTol          0;
*/

        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-8;
        relTol          0;

/*
        solver          GAMG;
	smoother 	symGaussSeidel;
        tolerance       1e-8;
        relTol          0;
*/

	minIter		2;
    }

    "rho.*"
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-8;
        relTol          0;
    }
}

PIMPLE
{
    //momentumPredictor 	yes;	//hardwired to yes in OF
    //consistent 			yes; 	//D commented

    transonic yes;

    nOuterCorrectors     1;		//1-2D-5R-10-20
    nCorrectors          2;		//2-3D
    nNonOrthogonalCorrectors 1;		//1-1D

//D commented
/*
    outerCorrectorResidualControl
    {
        //"(p|U|e|h)"
        ".*"
        {
            relTol          0.01;	//0.01-0.001
            tolerance       0.001;	//0.001-0.0001
        }
    }
*/

}

