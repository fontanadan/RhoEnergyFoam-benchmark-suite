FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      turbulenceProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

simulationType LES;

LES
{
    turbulence      on;
    LESModel        SpalartAllmarasDDES;
    delta	    cubeRootVol;

    // Optional entries
    SpalartAllmarasDESCoeffs
    {
        // Apply low-Reynolds number correction; default = yes
        lowReCorrection     yes;
    }
}
